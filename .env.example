# Backend port. Must not be 3000 — the Vite dev server uses 3000 and proxies /api here.
PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Administrator account, seeded on server start. Change the password before use.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Administrator
